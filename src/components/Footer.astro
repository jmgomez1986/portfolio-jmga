---
import { es } from "../i18n/es";
import { profile } from "../data/profile";
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-brand">JMGA</p>
    <p class="footer-copy muted">{es.footer.line}</p>
    <nav class="footer-links" aria-label="Links del pie">
      {es.navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .footer-copy {
    font-size: 0.82rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.82rem;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .footer-links {
      margin-left: 0;
    }
  }
</style>
