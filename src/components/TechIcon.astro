---
import { resolveTechIcon } from "../data/techIcons";

interface Props {
  /** Technology label exactly as it appears in copy or project data. */
  name: string;
}

const slug = resolveTechIcon(Astro.props.name);
---

{
  slug ? (
    <img
      class="tech-icon"
      src={`/icons/${slug}`}
      alt=""
      width="16"
      height="16"
      loading="lazy"
      aria-hidden="true"
    />
  ) : null
}
