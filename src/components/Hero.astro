---
import { es } from "../i18n/es";
import { profile } from "../data/profile";
---

<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="label hero-eyebrow">{es.hero.eyebrow}</p>
      <h1 class="hero-title">
        {es.hero.titlePlain} <span class="serif-italic">{es.hero.titleItalic}</span>
      </h1>
      <p class="hero-intro">{es.hero.intro}</p>

      <div class="hero-ctas">
        <a class="btn btn-solid" href="#projects">{es.hero.ctaPrimary} <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={profile.cvPath} target="_blank" rel="noopener">
          {es.hero.ctaSecondary} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="hero-socials">
        <a class="social-link" href={profile.links.github} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          <span>{profile.links.githubHandle}</span>
        </a>
        <a class="social-link" href={profile.links.linkedin} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          <span>{profile.links.linkedinHandle}</span>
        </a>
      </div>
    </div>

    <div class="hero-photo">
      <img
        src={profile.photo}
        alt={profile.photoAlt}
        width="600"
        height="760"
        class="portrait"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + 4.5rem);
    padding-bottom: 5rem;
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6.5vw, 4.5rem);
  }

  .hero-title .serif-italic {
    font-size: 0.94em;
  }

  .hero-intro {
    color: var(--muted);
    max-width: 46ch;
    margin-top: 1.25rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero-socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .social-link:hover {
    color: var(--accent);
  }

  .portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 3.8;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    filter: grayscale(100%);
    transition: filter 300ms ease;
  }

  .portrait:hover {
    filter: grayscale(0%);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: calc(var(--nav-h) + 2.5rem);
      padding-bottom: 3.5rem;
      min-height: 0;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    /* Text first, photo below — as agreed */
    .hero-copy {
      order: 0;
    }

    .hero-photo {
      order: 1;
      max-width: 420px;
    }
  }
</style>
