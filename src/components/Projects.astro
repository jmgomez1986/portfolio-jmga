---
import { es } from "../i18n/es";
import SectionHeader from "./SectionHeader.astro";
import BrowserPreview from "./BrowserPreview.astro";
import TechIcon from "./TechIcon.astro";
import projectData from "../data/projects.json";
import type { ProjectEntry } from "../i18n/types";

const projects = projectData as ProjectEntry[];
---

<section class="projects">
  <div class="container">
    <SectionHeader num="03" title={es.projects.title} id="projects" />
    <p class="intro muted">{es.projects.intro}</p>

    <div class="project-list">
      {
        projects.map((project, index) => (
          <article class={`card project-row reveal${index % 2 !== 0 ? " flipped" : ""}`} style={`--reveal-delay: ${index * 110}ms`}>
            <div class="project-media">
              {project.image ? (
                <img loading="lazy" src={project.image} alt={`Vista previa de ${project.title}`} width="720" height="480" />
              ) : (
                <BrowserPreview slug={project.slug} />
              )}
            </div>
            <div class="project-info">
              <h3>{project.title}</h3>
              {project.placeholder && <p class="placeholder-note muted">{es.projects.placeholderNote}</p>}
              <p class="desc muted">{project.description}</p>
              <ul class="tags" role="list">
                {project.tags.map((tag) => (
                  <li><TechIcon name={tag} />{tag}</li>
                ))}
              </ul>
              <div class="project-links">
                <a class="link-arrow" href={project.repoUrl} target="_blank" rel="noopener" aria-label={`${es.projects.repoLabel}: ${project.title}`}>
                  {es.projects.repoLabel} <span class="arrow" aria-hidden="true">↗</span>
                </a>
                <a class="link-arrow" href={project.liveUrl} target="_blank" rel="noopener" aria-label={`${es.projects.liveLabel}: ${project.title}`}>
                  {es.projects.liveLabel} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 5rem 0;
    border-top: 1px solid var(--border);
  }

  .intro {
    margin-top: -1.25rem;
    margin-bottom: 2.5rem;
    max-width: 52ch;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    padding: 1.75rem;
    align-items: center;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .project-row:hover {
    transform: translateY(-2px);
  }

  .project-info h3 {
    font-size: 1.4rem;
  }

  .placeholder-note {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .desc {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    max-width: 44ch;
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }

  .project-links {
    display: flex;
    gap: 1.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  /* Alternate media side */
  .project-row.flipped .project-media {
    order: 2;
  }

  .project-row.flipped .project-info {
    order: 1;
  }

  .project-media img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  @media (max-width: 860px) {
    .projects {
      padding: 3.5rem 0;
    }

    .project-row,
    .project-row.flipped {
      grid-template-columns: 1fr;
      padding: 1.25rem;
      gap: 1.25rem;
    }

    .project-row.flipped .project-media {
      order: 0;
    }

    .project-row.flipped .project-info {
      order: 1;
    }
  }
</style>
